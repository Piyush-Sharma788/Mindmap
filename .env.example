# Copy to .env (gitignored; loaded by the CLI, never printed) or export in your shell.
# Never commit real keys.

# Provider: anthropic (default) or gemini
MINDMAP_PROVIDER=gemini

# Gemini (Google AI Studio key). Free tier: requests are not billed, but Google may use
# free-tier content to improve its products; do not send confidential documents.
GEMINI_API_KEY=

# Anthropic (only needed when MINDMAP_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Optional overrides (defaults: claude-sonnet-5-5 / gemini-3.6-flash)
# MINDMAP_MODEL=
# MINDMAP_MODEL_GENERATE=
# MINDMAP_MODEL_GROW=
# MINDMAP_EFFORT=medium        # Anthropic only
